# Copie os valores para a aba Environment do Easypanel (uma variavel por linha).
# O Easypanel NAO le este arquivo automaticamente — serve apenas como referencia.
# NUNCA commite um .env com senhas reais no GitHub.

RCON_PASSWORD=troque-esta-senha
SERVER_HOSTNAME=BICHO SOLTO BRASIL | SOLO
SERVER_SEED=836891193
WORLD_SIZE=1800
MAX_PLAYERS=200
SERVER_PORT=28015
RCON_PORT=28016
QUERY_PORT=28017
APP_PORT=28082
SERVER_IDENTITY=rst
RUST_CARBON_ENABLED=1
# IP publico da VPS — necessario para aparecer na lista do Rust
SERVER_PUBLIC_IP=168.231.91.245
# Token Steam (GSLT) — gere em https://steamcommunity.com/dev/managegameservers App ID 252490
STEAM_GSLT=
